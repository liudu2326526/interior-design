[Unit]
Description=Interior Design Codex backend
Wants=network-online.target
After=network-online.target

[Service]
User=interior-design
Group=interior-design
WorkingDirectory=/opt/interior-design/app
ExecStart=/usr/bin/node /opt/interior-design/app/server.mjs
Environment=CODEX_PATH=/opt/interior-design/codex-runtime/bin/codex
Environment=STUDIO_IMPORT_JOBS_DIR=/var/lib/interior-design/import-jobs
Environment=STUDIO_UPLOAD_ARCHIVE_DIR=/var/lib/interior-design/uploads
Environment=STUDIO_PUBLIC_BRIDGE_TOKEN_FILE=/var/lib/interior-design/config/bridge.key
Environment=STUDIO_RENDER_IMAGE_CONFIG_FILE=/var/lib/interior-design/config/render-image.json
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/interior-design/app/projects /opt/interior-design/app/workdir /var/lib/interior-design
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
